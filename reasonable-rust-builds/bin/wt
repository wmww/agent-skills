#!/usr/bin/env python3
"""Task worktrees with warm targets: <repo>/.worktrees/wt<N> (gitignored), each with its own
in-tree target/ kept between tasks, so a task's first build recompiles only what its branch
changed. Policy: two stay warm per device; more are created when more agents run at once and
trimmed again after.

  wt claim <branch> [<base>]   lowest free worktree (a new one if none), <branch> checked out
                               (made from <base>, default main, if new); prints its path
  wt release [<path>]          prune its target, then free it (default: the one containing cwd)
  wt trim [<keep>]             remove free worktrees beyond the <keep> (default 2) lowest-numbered
  wt list

A claim is a marker in the common git dir, created atomically; release detaches HEAD (files
untouched, the branch is free to merge or delete) and removes the marker. After checkout, claim
runs the project's scripts/wt-setup if present (gitignored generated files a build needs).

Pruning keeps what is in use. Cargo reads every live unit's fingerprint on each build, even a
no-op one, so release runs `cargo build --workspace --all-targets` (marks the standard set) and then
deletes every unit (.fingerprint/<name>-<hash>, deps/*-<hash>*, build/<name>-<hash>) not read or
written since the previous release, plus every incremental/ dir not written since then (costs one
non-incremental compile of that crate if it was live). Then it resets access times so the next
read registers under relatime. Nothing is deleted on time alone, or without a stamp to compare to.
"""
import os, shutil, subprocess, sys, time
from pathlib import Path


def git(*args, cwd=None):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"wt: git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout.strip()


common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir"))
home = common.parent / ".worktrees"
claims = common / "wt-claims"


def wt_of(arg):
    p = Path(arg).resolve() if arg else Path(git("rev-parse", "--show-toplevel"))
    if p.parent != home or not p.name.startswith("wt"):
        sys.exit(f"wt: {p} is not a task worktree")
    return p


def clean(path):
    return not git("status", "--porcelain", cwd=path)


def claim(branch, base="main"):
    claims.mkdir(exist_ok=True)
    n = 1
    while True:
        try:
            fd = os.open(claims / f"wt{n}", os.O_WRONLY | os.O_CREAT | os.O_EXCL)
            break
        except FileExistsError:
            n += 1
    path = home / f"wt{n}"
    os.write(fd, f"{branch} (claimed {time.strftime('%Y-%m-%d %H:%M')})\n".encode())
    os.close(fd)
    try:
        if not path.exists():
            home.mkdir(exist_ok=True)
            git("worktree", "add", "-q", "--detach", str(path), base)
            print(f"wt: new worktree {path}: its first build is a cold one (a few minutes)", file=sys.stderr)
        if not clean(path):
            sys.exit(f"wt: {path} has uncommitted changes")
        exists = subprocess.run(["git", "rev-parse", "--verify", "-q", f"refs/heads/{branch}"],
                                cwd=path, capture_output=True).returncode == 0
        git("checkout", "-q", *([branch] if exists else ["-b", branch, base]), cwd=path)
        if (path / "scripts/wt-setup").exists() and subprocess.run(
                ["sh", "scripts/wt-setup"], cwd=path, stdout=subprocess.DEVNULL).returncode:
            sys.exit("wt: scripts/wt-setup failed")
    except SystemExit:
        (claims / f"wt{n}").unlink()
        raise
    print(path)


def files(d):
    for dirpath, _, names in os.walk(d):
        for f in names:
            yield os.path.join(dirpath, f)


def used_since(d, stamp):
    """Any file under d read or written since stamp (atime alone misses fresh writes)."""
    for f in files(d):
        st = os.lstat(f)
        if max(st.st_atime, st.st_mtime) > stamp:
            return True
    return os.lstat(d).st_mtime > stamp


def atime_works(tgt):
    probe = tgt / ".wt-atime-probe"
    probe.write_text("x")
    os.utime(probe, (0, time.time()))
    probe.read_text()
    ok = probe.stat().st_atime > 0
    probe.unlink()
    return ok


def du_gb(p):
    return int(subprocess.run(["du", "-sk", str(p)], capture_output=True, text=True).stdout.split()[0]) / 2**20


def prune(path):
    tgt = path / "target"
    if not tgt.is_dir():
        return
    if not atime_works(tgt):
        print("wt: this filesystem doesn't record access times (noatime): target not pruned", file=sys.stderr)
        return
    r = subprocess.run(["cargo", "build", "--workspace", "--all-targets", "--quiet"], cwd=path,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if r.returncode:
        print("wt: `cargo build --workspace --all-targets` failed: target not pruned", file=sys.stderr)
        return
    stamp_file = tgt / ".wt-pruned"
    profiles = [fp.parent for fp in [*tgt.glob("*/.fingerprint"), *tgt.glob("*/*/.fingerprint")]]
    if stamp_file.exists():
        stamp = stamp_file.stat().st_mtime
        before, units = du_gb(tgt), 0
        for prof in profiles:
            for unit in list((prof / ".fingerprint").iterdir()):
                if used_since(unit, stamp):
                    continue
                h = unit.name.rsplit("-", 1)[-1]
                for f in [*(prof / "deps").glob(f"*-{h}*"), *(prof / "examples").glob(f"*-{h}*"),
                          *(prof / "build").glob(f"*-{h}")]:
                    shutil.rmtree(f) if f.is_dir() and not f.is_symlink() else f.unlink()
                shutil.rmtree(unit)
                units += 1
            inc = prof / "incremental"
            for d in list(inc.iterdir()) if inc.is_dir() else []:
                if d.is_dir() and not any(os.lstat(x).st_mtime > stamp for x in [d, *d.iterdir()]):
                    shutil.rmtree(d)
        if units:
            print(f"wt: pruned {units} unused units, {before - du_gb(tgt):.1f} GB", file=sys.stderr)
    # atime <= mtime makes relatime record the next read; the stamp postdates every reset
    for prof in profiles:
        for f in files(prof / ".fingerprint"):
            st = os.lstat(f)
            os.utime(f, (st.st_mtime, st.st_mtime), follow_symlinks=False)
    stamp_file.touch()


def release(arg=None):
    path = wt_of(arg)
    if not clean(path):
        sys.exit(f"wt: {path} has uncommitted or untracked files; commit or remove them first")
    prune(path)
    git("checkout", "-q", "--detach", cwd=path)
    (claims / path.name).unlink(missing_ok=True)


def trim(keep=2):
    free = sorted((p for p in home.glob("wt*") if not (claims / p.name).exists()),
                  key=lambda p: int(p.name[2:]))
    for p in free[int(keep):]:
        if not clean(p):
            print(f"wt: {p} is dirty, kept", file=sys.stderr)
            continue
        git("worktree", "remove", "--force", str(p))
        shutil.rmtree(p, ignore_errors=True)
        print(f"removed {p}")


def show():
    for p in sorted(home.glob("wt*"), key=lambda p: int(p.name[2:])):
        c = claims / p.name
        print(p, c.read_text().strip() if c.exists() else "free")


cmd, *rest = sys.argv[1:] or ["help"]
if cmd == "claim" and 1 <= len(rest) <= 2:
    claim(*rest)
elif cmd == "release" and len(rest) <= 1:
    release(*rest)
elif cmd == "trim" and len(rest) <= 1:
    trim(*rest)
elif cmd == "list" and not rest:
    show()
else:
    sys.exit(__doc__)
